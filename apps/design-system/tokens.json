{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "meta": {
    "name": "Book Spine Detector",
    "version": "1.0.0",
    "platforms": ["android-compose", "ios-swiftui"]
  },
  "color": {
    "ink": "#0B1220",
    "surface": "#F7F8F3",
    "surfaceRaised": "#FFFFFF",
    "surfaceMuted": "#E9ECE5",
    "textPrimary": "#121A27",
    "textSecondary": "#5B6574",
    "accent": "#D8FF70",
    "accentStrong": "#B8E34D",
    "success": "#3ED598",
    "warning": "#FFBF69",
    "danger": "#FF6B6B",
    "onDark": "#F8FAF5",
    "scrim": "#99070B12"
  },
  "radius": { "small": 10, "medium": 18, "large": 28, "pill": 999 },
  "space": { "xs": 4, "sm": 8, "md": 16, "lg": 24, "xl": 32 },
  "type": {
    "family": "system-sans",
    "countSize": 64,
    "titleSize": 24,
    "bodySize": 16,
    "labelSize": 13
  },
  "motion": { "quickMs": 180, "standardMs": 280 }
}
